#pragma once
/// @file racing_baseline.hpp
/// @brief GENERATED by cmake/baselines.cmake from baselines/@BASELINE_NAME@.yaml. Do not edit.

#include <branes/racing/compose/stack.hpp>
#include <branes/racing/harness/harness.hpp>

#include <filesystem>
#include <string>
#include <string_view>

@BASELINE_INCLUDES@

namespace branes::racing::baseline {

/// The baseline this binary was built for.
inline constexpr std::string_view name = "@BASELINE_NAME@";

/// SHA-256 of the canonical composition ("slot=Impl\n", slots sorted).
inline constexpr std::string_view composition_hash = "@BASELINE_HASH@";

/// The baseline's slot composition, instantiated for scalar type T.
template <typename T>
using Composition = Stack<T,
                                 @BASELINE_TYPES@>;

/// The baseline file, which must name this binary's baseline and its
/// composition (its hash).
[[nodiscard]] inline result<config::BaselineConfig, std::string> check_baseline(const std::filesystem::path& dir) {
    return harness::check_baseline(dir, name, composition_hash);
}

/// The hash the log records: the composition's.
template <typename T>
[[nodiscard]] std::string hash(const Composition<T>&) {
    return std::string(composition_hash);
}

}  // namespace branes::racing::baseline
