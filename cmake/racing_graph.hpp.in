#pragma once
/// @file racing_baseline.hpp
/// @brief GENERATED by cmake/baselines.cmake (anatomy's flow_add_baseline) from
/// baselines/@FLOW_NAME@.yaml: what fills its graph. Do not edit.
///
/// The harnesses' view of a baseline is the slot build's (racing_baseline.hpp.in):
/// its name, its stack, the check of its file, and the hash its log records.

#include <branes/racing/flow/graph.hpp>
#include <branes/racing/harness/harness.hpp>

@FLOW_INCLUDES@

#include <filesystem>
#include <string>
#include <string_view>

namespace branes::racing::baseline {

/// The baseline this binary was built for.
inline constexpr std::string_view name = "@FLOW_NAME@";

/// What fills the graph: a body per composite, instantiated for scalar type T.
template <typename T>
struct Graph {
    static constexpr std::string_view name = "@FLOW_NAME@";
    static constexpr flow::baseline_class kind = flow::baseline_class::@FLOW_CLASS@;
    struct bodies {
@FLOW_BODIES@    };
};

/// The baseline's stack: its graph's CPU stack, instantiated for scalar type T.
template <typename T>
using Composition = graph::Stack<T, Graph<T>>;

/// The baseline file, which must name this binary's baseline. Its graph is
/// checked against the graph built, when the stack is (G8).
[[nodiscard]] inline result<config::BaselineConfig, std::string> check_baseline(const std::filesystem::path& dir) {
    return harness::check_graph_baseline(dir, name);
}

/// The hash the log records: the graph's.
template <typename T>
[[nodiscard]] std::string hash(const Composition<T>& stack) {
    return stack.hash();
}

}  // namespace branes::racing::baseline
